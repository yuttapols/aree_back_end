# คัดลอกเป็น .env แล้วกรอกค่าจริง — ห้าม commit ไฟล์ .env
DB_PASSWORD=change-me
# สร้างด้วย: openssl rand -base64 48
JWT_SECRET=
ROTI_ADMIN_PHONE=0800000000
# อย่างน้อย 8 ตัว มีทั้งตัวอักษรและตัวเลข — ต้องเปลี่ยนเมื่อ login ครั้งแรก
ROTI_ADMIN_PASSWORD=
CORS_ALLOWED_ORIGINS=http://localhost:4200
# Cloudinary — เอาจาก Dashboard > API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
LOGIN_LOG_RETENTION_DAYS=90
# Render Starter (512MB) — pool เล็กพอ
DB_POOL_SIZE=5
# Strict = FE proxy /api มาที่ backend (โดเมนเดียวกัน) · None = เรียกข้ามโดเมน — ดู docs/DEPLOY.md ข้อ 3
REFRESH_COOKIE_SAME_SITE=Strict
